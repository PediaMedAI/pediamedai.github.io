{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range .Data.Pages }}
    {{- if and (not .Params.private) (ne .Kind "404") }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- $lastmod := .Lastmod }}
    {{- if not $lastmod.IsZero }}
    <lastmod>{{ $lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- /* Hugo defaults page priority to -1 ("unset"). Respect any
           explicit per-page override (>= 0); otherwise derive from
           page Kind so crawlers see the home and section indexes
           ranked above deep singles. */ -}}
    {{- $priority := .Sitemap.Priority -}}
    {{- if lt $priority 0.0 -}}
      {{- if .IsHome -}}{{ $priority = 1.0 -}}
      {{- else if eq .Kind "section" -}}{{ $priority = 0.8 -}}
      {{- else if and (eq .Kind "page") (eq .Section "team") -}}{{ $priority = 0.7 -}}
      {{- else -}}{{ $priority = 0.5 -}}
      {{- end -}}
    {{- end }}
    <priority>{{ $priority }}</priority>
  </url>
    {{- end }}
  {{ end }}
</urlset>
